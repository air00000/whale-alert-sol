# Required
TELEGRAM_BOT_TOKEN=
HELIUS_API_KEY=

# Optional but recommended for production if you need higher Jupiter rate limits
JUPITER_API_KEY=

# Optional explicit URLs
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_ENHANCED_BASE_URL=https://api-mainnet.helius-rpc.com
# JUPITER_BASE_URL=https://api.jup.ag
# JUPITER_TOKENS_BASE_URL=https://api.jup.ag/tokens/v2
# JUPITER_PRICE_URL=https://api.jup.ag/price/v3

# Storage
